{
	admin off
	auto_https disable_redirects
	skip_install_trust
	# Clients send no SNI when KAI_DOMAIN is an IP; without this, the handshake finds no certificate.
	default_sni {$KAI_DOMAIN}
	servers {
		protocols h1 h2
	}
}

https://{$KAI_DOMAIN}:443 {
	reverse_proxy api:{$KAI_APP_PORT:3080} {
		flush_interval -1
	}
}

# Admin Panel on its own port, so it can be firewalled to admin IPs separately from chat.
https://{$KAI_DOMAIN}:8443 {
	reverse_proxy admin-panel:3000
}
