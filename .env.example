# APLIKASI LOKAL / SERVER INTERNAL
# Port aplikasi. Default 3080; jika diubah, sesuaikan origin dan SSH tunnel juga.
PORT=3080
# Biarkan 1000 sesuai user pada image aplikasi saat ini. Ini bukan ID user platform.
UID=1000
# Biarkan 1000 sesuai grup pada image aplikasi saat ini.
GID=1000

# URL yang dibuka di browser dan menjadi dasar tautan aktivasi akun.
# Lokal / SSH tunnel: http://localhost:3080
# Contoh HTTPS setelah domain/proxy siap: https://ai.perusahaan.example
# Jangan sekadar mengganti URL untuk mengaktifkan HTTPS; lihat MOP/panduan TLS.
DOMAIN_CLIENT=http://localhost:3080

# Origin server untuk alur autentikasi. Pada deployment satu domain, samakan dengan DOMAIN_CLIENT.
DOMAIN_SERVER=http://localhost:3080

APP_TITLE=K-AI platform
# Teks footer chat. Kosong pada template memakai nama bawaan platform dari Compose.
CUSTOM_FOOTER=K-AI platform
# Biarkan custom,agents untuk integrasi model dan fitur agent yang dipakai saat ini.
# Mengaktifkan endpoint tidak memberi user izin membuat agent atau menggunakan MCP.
ENDPOINTS=custom,agents

# true: login email/password platform diaktifkan. Ini bukan login memakai akun CH.
ALLOW_EMAIL_LOGIN=true
# Biarkan false: tidak ada pendaftaran mandiri. Admin pertama dibuat dengan `make admin-create`;
# akun berikutnya melalui Admin Panel → Users → Add user.
ALLOW_REGISTRATION=false
# Biarkan false; login sosial/SSO belum menjadi jalur yang dipakai proyek ini.
ALLOW_SOCIAL_LOGIN=false
# Biarkan false agar akun tidak dibuat melalui penyedia login sosial.
ALLOW_SOCIAL_REGISTRATION=false
# Biarkan false sampai pengiriman email dan alur pemulihan password dikonfigurasi serta diuji.
# Aktivasi akun baru memakai tautan sekali pakai dari admin dan tidak memerlukan pengaturan ini.
ALLOW_PASSWORD_RESET=false

# true dipakai pada pengembangan tanpa layanan verifikasi email.
# Tinjau kebijakan verifikasi sebelum akses publik; ini bukan persetujuan konfigurasi produksi.
ALLOW_UNVERIFIED_EMAIL_LOGIN=true
# Biarkan false jika fitur berbagi percakapan belum disetujui.
ALLOW_SHARED_LINKS=false
# Biarkan false agar percakapan tidak dibagikan secara publik.
ALLOW_SHARED_LINKS_PUBLIC=false

# SECRET OTOMATIS — BIARKAN KOSONG PADA SALINAN BARU
# make setup mengisi field secret kosong dengan nilai acak dan mempertahankan nilai yang sudah ada.
# Jangan mengisi contoh key, memakai key bersama, atau mengganti key instalasi aktif.
# CREDS_KEY: key enkripsi aplikasi; kehilangan/perubahan key dapat membuat kredensial tersimpan tidak terbaca.
CREDS_KEY=
# Diuat otomatis bersama key aplikasi. Pertahankan saat update atau pemulihan.
CREDS_IV=
# Secret token login; dibuat otomatis. Jangan isi dengan password pengguna.
JWT_SECRET=
# Secret refresh token; dibuat otomatis dan terpisah dari JWT_SECRET.
JWT_REFRESH_SECRET=

# Secret pencarian Meilisearch; dibuat otomatis. Bukan API key penyedia model.
MEILI_MASTER_KEY=
# Biarkan true untuk menonaktifkan analitik Meilisearch.
MEILI_NO_ANALYTICS=true

# POSTGRES UNTUK RAG (service vectordb, profile documents)
# Dipakai vectordb dan rag_api saat `make documents-up`. Contoh default: kai_rag.
# Mengisi bagian ini tidak otomatis menjalankan RAG.
POSTGRES_DB=kai_rag
POSTGRES_USER=kai_rag
# Biarkan kosong pada salinan baru; make setup membuat password acak. Pertahankan pada instalasi aktif.
POSTGRES_PASSWORD=

# PENYEDIA MODEL — ISI SENDIRI UNTUK CHAT
# Masukkan API key Ollama Cloud milik lingkungan ini; jangan kirim key melalui chat atau commit ke Git.
# Contoh pengisian: OLLAMA_API_KEY=<API_KEY_OLLAMA_ANDA>
OLLAMA_API_KEY=

# LEGACY: variabel ini tidak memilih model aktif pada konfigurasi LibreChat saat ini.
# Model aktif ditetapkan oleh anchor kai_model di deploy/librechat.yaml / konfigurasi admin yang didukung.
# Contoh model pengembangan saat ini: gpt-oss:120b. Mengubah baris ini saja tidak mengganti model.
OLLAMA_MODEL=gpt-oss:120b

# INFERENSI GEMINI DI VERTEX AI (keputusan owner 6 Nov 2026; Ollama Cloud tetap sebagai cadangan)
# Kosongkan semua = tetap Ollama Cloud. Isi semua lalu: make admin-up && make agents-setup
# (agent Umum dan CH dipindah di tempat, ID dan akses tetap). Panduan: Docs/runbooks/inference-vertex.md
# Provider LibreChat untuk Gemini: google
KAI_AGENT_PROVIDER=
# ID model persis dari Vertex Model Garden (jangan ditebak). Umum = tier Flash, CH = tier Pro.
KAI_GENERAL_AGENT_MODEL=
KAI_CH_AGENT_MODEL=
# Path absolut JSON service account di server (chown root:1000, chmod 440). Jangan commit / kirim lewat chat.
KAI_VERTEX_KEY_FILE=
# Region Vertex, mis. asia-southeast2 (Jakarta) atau global; pastikan model tersedia di region itu.
KAI_VERTEX_LOCATION=

# ADMIN PANEL
# Biarkan kosong pada salinan baru; dibuat otomatis oleh make setup. Pertahankan saat update.
ADMIN_PANEL_SESSION_SECRET=

# ALAMAT ANTAR-SERVICE (P1-14)
# Kosong = nama service compose di host yang sama (default). Isi hanya bila stack dipisah ke beberapa
# server, mis. KAI_S3_ENDPOINT=https://files.internal:9000. Lalu lintas lintas server wajib TLS (P1-15),
# MongoDB lintas host wajib auth+TLS (P1-16). MCP tetap memakai hostname clickhouse-mcp (extra_hosts).
KAI_MONGO_URI=
KAI_MEILI_HOST=
KAI_S3_ENDPOINT=
KAI_VECTORDB_HOST=
KAI_EMBEDDINGS_BASE_URL=

# RETENSI LOG (P6-11)
# Berapa hari audit MCP (volume audit-logs) dan log file LibreChat (volume logs) disimpan.
# Bilangan bulat 1-3650; default 90 (3 bulan). Berlaku setelah recreate api dan clickhouse-mcp.
KAI_LOG_RETENTION_DAYS=90

# OBJECT STORAGE (RustFS, P6-12)
# Dokumen yang di-upload disimpan di RustFS lokal (S3-compatible, tanpa port publik).
# Biarkan kosong; dibuat otomatis oleh make setup. Bila diganti, recreate rustfs dan api
# bersamaan (keduanya membaca nilai yang sama); data di bucket tidak terpengaruh.
KAI_S3_ACCESS_KEY=
KAI_S3_SECRET_KEY=
# User RustFS untuk api, hanya boleh akses bucket di bawah (dibuat rustfs-init). Juga dibuat make setup.
KAI_S3_APP_ACCESS_KEY=
KAI_S3_APP_SECRET_KEY=
# Nama bucket (opsional).
KAI_S3_BUCKET=kai-files

# URL panel admin yang dibuka operator. Lokal / SSH tunnel: http://localhost:3081
# Jangan menganggap URL ini otomatis memublikasikan atau mengamankan panel pada domain HTTPS.
ADMIN_PANEL_URL=http://localhost:3081

DEBUG_LOGGING=false
DEBUG_CONSOLE=false

# TLS OPSIONAL — BOLEH KOSONG UNTUK LOKAL / SSH TUNNEL
# Hostname saja, tanpa https://, port atau path. Contoh: ai.perusahaan.example
# Diperlukan jika memakai deploy/docker-compose.tls.yml; domain/DNS/sertifikat harus disiapkan.
KAI_DOMAIN=

# Default lokal 0. Overlay TLS yang ada mengaturnya menjadi 1 untuk satu hop reverse proxy.
TRUST_PROXY=0

# false untuk HTTP localhost. Overlay TLS yang ada mengaturnya menjadi true untuk HTTPS.
SESSION_COOKIE_SECURE=false

# MCP CLICKHOUSE OPSIONAL — SEMUA NILAI DI FILE INI
# false: chat umum tanpa layanan MCP. true: jalankan MCP privat dengan make setup lalu make mcp-up.
# Migrasi konfigurasi lama mempertahankan layanan yang sebelumnya aktif.
KAI_MCP_ENABLED=false

# Hostname database saja, tanpa https://, port, path atau koma.
# Contoh: warehouse.perusahaan.example. Isi hanya setelah target disetujui.
CLICKHOUSE_HOST=
# Port HTTPS ClickHouse Cloud umumnya 8443; sesuaikan target yang disetujui.
CLICKHOUSE_PORT=8443
# Dipaksa true oleh overlay MCP; jangan nonaktifkan TLS/verifikasi sertifikat.
CLICKHOUSE_SECURE=true
CLICKHOUSE_VERIFY=true

# Batas per query yang dikirim MCP ke ClickHouse. Kosong = default (25 detik, 4 GiB memori,
# 1 miliar baris, 100 GiB dibaca). Jika profile DBA mengunci setting (CONST), nilai DBA yang berlaku.
KAI_CH_MAX_EXECUTION_TIME=
KAI_CH_MAX_MEMORY_USAGE=
KAI_CH_MAX_ROWS_TO_READ=
KAI_CH_MAX_BYTES_TO_READ=

# Akun dasar sengaja tidak dapat dipakai untuk akses warehouse; bukan akun ADMIN.
# Mode managed tidak memakai akun ini sebagai fallback identitas user.
CLICKHOUSE_USER=kai_unbound
# Biarkan kosong pada instalasi baru; dibuat otomatis saat MCP diaktifkan.
# Bukan tempat memasukkan password ClickHouse pribadi pengguna.
CLICKHOUSE_PASSWORD=
# Token transport privat antara API dan MCP, bukan key Cloud atau password database.
# Biarkan kosong pada instalasi baru; dibuat otomatis saat MCP diaktifkan.
CLICKHOUSE_MCP_AUTH_TOKEN=
# Token privat arah sebaliknya: MCP memeriksa user ke API internal platform. Harus berbeda.
# Biarkan kosong pada instalasi baru; dibuat otomatis saat MCP diaktifkan.
KAI_PLATFORM_INTERNAL_TOKEN=

# Mode managed tetap diwajibkan oleh overlay. Pencatatan user/role tidak mengaktifkan binding.
# DSN kosong membuat akses warehouse ditolak; isi setelah metadata dan kunci disiapkan.
KAI_BINDING_DSN=
# Login PostgreSQL terpisah, hanya EXECUTE operasi pengaturan akses oleh admin.
# Persiapan store/migrasi/grant/kunci dilakukan operator; bukan username/password CH.
KAI_ENROLLMENT_DSN=
# Metadata lokal Docker khusus pengembangan. make warehouse-local-setup menyiapkannya.
# Tidak membuat tabel/user di CH. Volume data/key persisten; jangan dihapus saat restart.
KAI_LOCAL_METADATA_ENABLED=false
# Khusus container PostgreSQL metadata lokal; dibuat helper sekali, tidak dikirim ke API/MCP.
# Bukan password CH, bukan password akun platform.
KAI_METADATA_ADMIN_PASSWORD=
# Versi file kunci aktif, misalnya 1 untuk file 1.key pada direktori keyring terlindungi.
KAI_BINDING_ACTIVE_KEY_VERSION=1
# Path di dalam container; overlay keyring bawaan selalu memakai /run/kai-binding-keys.
# File key dan mount terlindungi tetap perlu disiapkan terpisah.
KAI_BINDING_KEY_DIR=/run/kai-binding-keys
# Opsional: direktori keyring absolut di host Linux, misalnya /srv/kai/keys/bindings.
# Direktori harus sudah ada, milik UID 10001, mode 0700/0500; N.key raw 32 byte mode 0600/0400.
# Biarkan kosong sampai operator menyiapkan kunci dan backup. Make menambahkan mount read-only jika diisi.
# Ini bukan isi kunci. Jangan memakai CREDS_KEY aplikasi atau menaruh key dalam repo.
KAI_BINDING_KEY_SOURCE=
# URL internal untuk verifikasi sesi LibreChat; jangan arahkan ke URL pengguna sembarang.
KAI_LIBRECHAT_INTERNAL_URL=http://api:3080
KAI_LIBRECHAT_ISSUER=librechat-local

# METRICS MCP PRIVAT OPSIONAL
# Kosong = metrics belum aktif. make metrics-up membuat token khusus sekali dan menyimpannya di sini.
# Token harus 64 karakter hex huruf kecil dan berbeda dari token transport MCP. Jangan pakai API key model.
# Hanya container MCP yang menerima nilai ini; tidak ada port metrics publik.
KAI_METRICS_TOKEN=

# Semua nilai diedit di .env root; file mcp.env dan metrics.env lama dimigrasikan oleh make setup.
# Jangan masukkan .env atau secret ke Git, image, tiket atau chat.
# Panduan: ../Docs/runbooks/environment-files.md dan ../Docs/runbooks/mop-server-deployment.md.

# RAG dokumen (profile documents): embedding lokal via service `embeddings` (llama.cpp, CPU),
# tanpa model komersial. Jalankan `make documents-up`, lalu isi KAI_RAG_API_URL dan recreate api.
# Kosong = LibreChat tidak memakai RAG. Nilai lokal: http://rag_api:8000
KAI_RAG_API_URL=
# Kosong = gpustack/bge-m3-GGUF bge-m3-Q8_0.gguf, chunk 1500 karakter overlap 100.
# Ubah model atau chunk perlu restart embeddings/rag_api dan index ulang dokumen.
KAI_EMBEDDINGS_HF_REPO=
KAI_EMBEDDINGS_HF_FILE=
KAI_RAG_CHUNK_SIZE=
KAI_RAG_CHUNK_OVERLAP=
